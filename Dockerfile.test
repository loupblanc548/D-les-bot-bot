# Isolated integration-test image (no Discord token, no production secrets)
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./
COPY scripts ./scripts

# Skip native postinstall (raknet/canvas) then stub raknet like production
RUN npm ci --ignore-scripts \
  && node -e "const fs=require('fs');const p='node_modules/raknet-native/binding.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace(\"require('bindings')\",\"function(){return new Proxy({},{get:function(){return function(){}}})}\");fs.writeFileSync(p,c);console.log('Patched raknet-native')}"

COPY . .

ENV NODE_ENV=test
ENV DATABASE_URL="postgresql://test:test@postgres-test:5432/bot_test?schema=public"
ENV DISCORD_TOKEN=test-discord-token
ENV DISCORD_CLIENT_ID=123456789012345678
ENV DISCORD_GUILD_ID=123456789012345678
ENV OWNER_ID=123456789012345678

RUN npx prisma generate

CMD ["npx", "vitest", "run", "--reporter=verbose"]
