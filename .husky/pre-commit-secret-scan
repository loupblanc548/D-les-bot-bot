#!/usr/bin/env bash
# Pre-commit secret scanner — checks for Discord/Neon/Telegram/API keys
# Falls back gracefully if detect-secrets is not installed
set -euo pipefail

if command -v detect-secrets &>/dev/null; then
  detect-secrets-hook --baseline .secret-scan.json "$@"
elif [ -f ".secret-scan.json" ]; then
  # Fallback: grep for common secret patterns
  PATTERNS=(
    '[MN][A-Za-z0-9]{23}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27}'
    'postgresql://[^:]+:[^@]+@[^.]+\.neon\.tech'
    '[0-9]{9,10}:AA[A-Za-z0-9_-]{35}'
    'sk-or-v1-[a-f0-9]{48}'
    'gsk_[a-zA-Z0-9]{52}'
  )
  FOUND=0
  for pattern in "${PATTERNS[@]}"; do
    if grep -rE "$pattern" --include='*.ts' --include='*.js' --include='*.json' --include='*.env' --include='*.yml' --exclude-dir=node_modules --exclude-dir=.git --exclude-dir=dist -l . 2>/dev/null | head -1 | grep -q .; then
      echo "⚠️  Potential secret detected matching pattern: $pattern"
      FOUND=1
    fi
  done
  if [ "$FOUND" -eq 1 ]; then
    echo "❌ Secrets detected! Remove them before committing."
    echo "   If this is a false positive, install detect-secrets: pip install detect-secrets"
    exit 1
  fi
fi

exit 0
