{
  "name": "Discord Bot Dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers-contrib/features/playwright:1": {}
  },
  "forwardPorts": [3000, 3005, 5432, 6379],
  "postCreateCommand": "npm ci && npx prisma generate",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "prisma.prisma",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  },
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_USER": "discord_bot",
        "POSTGRES_PASSWORD": "discord_bot",
        "POSTGRES_DB": "discord_bot"
      },
      "ports": ["5432:5432"]
    },
    "redis": {
      "image": "redis:7-alpine",
      "ports": ["6379:6379"]
    }
  },
  "remoteEnv": {
    "DATABASE_URL": "postgresql://discord_bot:discord_bot@localhost:5432/discord_bot?schema=public",
    "REDIS_URL": "redis://localhost:6379"
  }
}
