# Standby config — Qwen/Ollama stay on disk, not in RAM.
# Copy these into .env. Do NOT `ollama rm` the models.
# Unload RAM: bash scripts/ollama-standby.sh
# See docs/LOCAL_LLM_SETUP.md

LOCAL_LLM_ENABLED=false
OLLAMA_STANDBY=true

# Kept for the later Llama install (uncomment + flip the two flags above):
# LOCAL_LLM_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
