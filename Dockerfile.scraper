FROM node:20-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    ca-certificates fonts-liberation libnss3 libatk-bridge2.0-0 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxrandr2 xdg-utils wget unzip git \
    libgtk-3-0 libgbm1 libasound2 libpangocairo-1.0-0 --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm ci
RUN npx playwright install --with-deps
COPY . .
CMD ["node", "scripts/run-scraper.js"]
