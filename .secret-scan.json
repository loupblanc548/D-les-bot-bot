{
  "version": "1.0",
  "plugins": [
    {
      "id": "detect-secrets"
    }
  ],
  "rules": [
    {
      "id": "discord-token",
      "pattern": "[MN][A-Za-z\\d]{23}\\.[\\w-]{6}\\.[\\w-]{27}",
      "description": "Discord bot token"
    },
    {
      "id": "neon-db-url",
      "pattern": "postgresql://[^:]+:[^@]+@[^.]+\\.neon\\.tech",
      "description": "Neon database URL with credentials"
    },
    {
      "id": "telegram-bot-token",
      "pattern": "\\d{9,10}:AA[\\w-]{35}",
      "description": "Telegram bot token"
    },
    {
      "id": "openrouter-key",
      "pattern": "sk-or-v1-[a-f0-9]{48}",
      "description": "OpenRouter API key"
    },
    {
      "id": "groq-key",
      "pattern": "gsk_[a-zA-Z0-9]{52}",
      "description": "Groq API key"
    },
    {
      "id": "generic-api-key",
      "pattern": "(?i)(api[_-]?key|secret[_-]?key|password)\\s*[:=]\\s*['\"][^'\"]{16,}['\"]",
      "description": "Generic API key or password assignment"
    }
  ]
}
